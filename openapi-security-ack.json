{
  "openapi": "3.1.0",
  "info": {
    "title": "MainBrella security ack",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "operatorBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated operator token; customer credentials are not accepted."
      },
      "upstreamBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Disposable scoped token used only by the test acknowledgment upstream."
      }
    },
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/runs/{runId}/{action}": {
      "get": {
        "operationId": "acknowledgeSecurityProbe",
        "tags": [
          "Security infrastructure"
        ],
        "security": [
          {
            "upstreamBearer": []
          },
          {}
        ],
        "summary": "Disposable qualification upstream acknowledgment and adversaries",
        "description": "Test fixture only. Never returns a credential in an ordinary acknowledgment. Reflection actions deliberately return disposable test credentials to verify relay rejection. Tokens and runs expire after 15 minutes.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "runId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "public",
                "auth",
                "slow",
                "redirect",
                "reflect",
                "reflect-base64",
                "reflect-header"
              ]
            },
            "required": true,
            "name": "action",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Fixed JSON acknowledgment, or a deliberately reflected disposable credential for an adversarial action."
          },
          "302": {
            "description": "Deliberate redirect to an owned denied destination."
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "provider": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Conflicts with current state.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "provider": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
