{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [
      "./cloudflare-configuration.d.ts",
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "worker/**/*.ts",
    "cloudflare-configuration.d.ts",
    "scripts/deploy-previews-preflight*.ts"
  ]
}
