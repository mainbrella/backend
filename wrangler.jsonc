{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "mainbrella-api",
	"account_id": "2b7a9be82bb64187230703b024e25157",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-18",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"cache": {
		"enabled": true
	},
	"ai": { "binding": "AI" },
	"workflows": [{ "binding": "BUILD_WORKFLOW", "name": "mainbrella-build", "class_name": "BuildWorkflow" }],
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"vars": {
		"BUILD_ENABLED": "true",
		"BUILD_MODEL": "@cf/zai-org/glm-5.3",
		"STRIPE_PREPAID_PRICE_ID": "price_1UOno4GSUs8K8zgHhtAJjabl",
		"ACTIVITY_WEBSOCKET_ENABLED": "true",
		"PREVIEWS_ENABLED": "true",
		"PROJECT_HOSTING_ENABLED": "true",
		"PROJECT_DOMAIN_PROVIDER": "cloudflare",
		"PROJECT_CLOUDFLARE_ZONE_ID": "e6597a41a75e1abb92f4bc5e5758c460",
		"WORKSPACE_PERSISTENCE_ENABLED": "true",
		"ACQUISITION_ENABLED": "true",
		"PREVIEW_DOMAIN": "mainbrella.dev",
		"GOOGLE_CLIENT_ID": "854186419005-l0u2olqlqe40qmgin0q8tjpvftooi6ac.apps.googleusercontent.com"
	},
	"send_email": [
		{ "name": "WELCOME_EMAIL", "allowed_sender_addresses": ["andrew@mainbrella.com"] }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "delta",
			"database_id": "41be6d7b-26fb-4701-a3fb-fdf3454e14f9",
			"migrations_dir": "migrations",
			"migrations_table": "schema_migrations"
		},
		{
			"binding": "PREVIEW_ROUTES",
			"database_name": "mainbrella-preview-routes",
			"database_id": "d5f35d95-114c-4b71-9060-e99514136671",
			"migrations_dir": "preview-migrations"
		}
	],
	"ratelimits": [
		{
			"name": "EMAIL_AUTH_LIMIT",
			"namespace_id": "1002",
			"simple": { "limit": 20, "period": 60 }
		},
		{
			"name": "ACQUISITION_SUBMISSION_LIMIT",
			"namespace_id": "1003",
			"simple": { "limit": 20, "period": 60 }
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ACCOUNT_ACTIVITY",
				"class_name": "AccountActivity"
			},
			{
				"name": "CONTAINER_ACCOUNT",
				"class_name": "ContainerAccount"
			},
			{
				"name": "USER_CONTAINER",
				"class_name": "UserContainer",
				"script_name": "mainbrella-containers"
			}
		]
	},
	"exports": {
		"AccountActivity": {
			"type": "durable-object",
			"storage": "sqlite"
		},
		"ContainerAccount": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	"routes": [
		{
			"pattern": "api.mainbrella.com",
			"custom_domain": true
		}
	]
}
