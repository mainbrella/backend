{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mainbrella-outbox-qualification",
  "account_id": "2b7a9be82bb64187230703b024e25157",
  "main": "webhook-outbox-worker.js",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "WORKLOAD_WEBHOOKS_ENABLED": "true", "WEBHOOK_ALLOWED_HOSTS": "mainbrella-webhook-qualification.crimson-dust-553b.workers.dev" },
  "durable_objects": { "bindings": [{ "name": "OUTBOX", "class_name": "WebhookOutboxProbe" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WebhookOutboxProbe"] }]
}
