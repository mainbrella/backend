{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "mainbrella-security-ack",
  "account_id": "2b7a9be82bb64187230703b024e25157",
  "main": "worker/security-ack.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "SECURITY_ACK", "class_name": "SecurityAcknowledgment" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SecurityAcknowledgment"] }]
}
