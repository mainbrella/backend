{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mainbrella-egress-relay",
  "account_id": "2b7a9be82bb64187230703b024e25157",
  "main": "worker/security-relay.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "EGRESS_RELAY", "class_name": "EgressRelay" }] },
  "containers": [{ "class_name": "EgressRelay", "scheduling_policy": "durable_object", "images": { "relay": { "dockerfile": "./services/egress-relay.Dockerfile", "build_context": "." } } }],
  "exports": { "EgressRelay": { "type": "durable-object", "storage": "sqlite" } }
}
